[Unit]
Description=NodeForge Sing-box
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/sing-box run -c /etc/nodeforge-singbox/config.json
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/nodeforge-singbox

[Install]
WantedBy=multi-user.target
